  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,prisma}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
